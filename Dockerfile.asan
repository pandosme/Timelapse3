# Debug-only build: the app under AddressSanitizer, for chasing the heap corruption that
# aborts the process at shutdown ("corrupted size vs. prev_size while consolidating").
# Not part of ./build.sh - build it with ./build-asan.sh and install it on ONE camera.
ARG ARCH=aarch64
ARG VERSION=12.11.0
ARG UBUNTU_VERSION=24.04
ARG REPO=axisecp
ARG SDK=acap-native-sdk

FROM ${REPO}/${SDK}:${VERSION}-${ARCH}-ubuntu${UBUNTU_VERSION}
ARG ARCH

WORKDIR /opt/app
COPY ./app .
COPY ./third_party /opt/third_party
COPY ./tools/asan/asan_options.c ./asan_options.c

RUN set -eu; \
	mkdir -p /opt/app/bin /opt/app/lib; \
	cp "/opt/third_party/ffmpeg/${ARCH}/ffmpeg" /opt/app/bin/ffmpeg; \
	chmod 755 /opt/app/bin/ffmpeg; \
	cp /opt/axis/acapsdk/sysroots/${ARCH}/usr/lib/libasan.so.8* /opt/app/lib/

# -s strips the symbols an ASan report needs to be worth anything, and the sanitizer wants
# frame pointers and a real -g. The rpath is where the packaged libasan.so.8 lands on device.
RUN set -eu; \
	sed -i 's|^OBJS1\t= |OBJS1\t= asan_options.c |' Makefile; \
	sed -i 's| -s -lm| -lm|' Makefile; \
	printf 'CFLAGS += -fsanitize=address -fno-omit-frame-pointer -g -O1\nLDFLAGS += -fsanitize=address -Wl,-rpath,/usr/local/packages/timelapse2/lib\n' >> Makefile

RUN . /opt/axis/acapsdk/environment-setup* && acap-build . \
	-a 'bin/ffmpeg' \
	-a 'lib/libasan.so.8' \
	-a 'settings/settings.json' \
	-a 'settings/events.json'
